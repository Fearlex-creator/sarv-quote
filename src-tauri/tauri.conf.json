{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sarv",
  "version": "0.1.0",
  "identifier": "app.free-accounting.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5178",
    "beforeDevCommand": "pnpm --dir web dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Sarv \u2014 Accounting",
        "width": 1400,
        "height": 940,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
