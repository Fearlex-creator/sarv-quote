+    pub(super) fn choose_draft_selection_async(
+        self: &Rc<Self>,
+        selection: DraftSelection,
+        complete: impl FnOnce(&Rc<Self>, Result<bool>) + 'static,
+    ) {
+        if self.persistence_busy.get() {
+            complete(
