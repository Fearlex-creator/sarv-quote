+                complete(self, Err(error));
+                return;
+            }
+        };
+        let directory = self.store.borrow().directory.clone();
+        let detached = self.store.borrow_mut().begin_detached();
+        let (generation, mut candidate) = match detached {
+            Ok(value) => value,
+            Err(error) => {
+                complete(self, Err(error));
+                return;
+            }
+        };
