{
  "name": "sarv",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node scripts/start-desktop.mjs",
    "desktop:install": "bash scripts/install-desktop.sh",
    "dev": "pnpm --dir desktop exec tauri dev",
    "tauri": "pnpm --dir desktop exec tauri",
    "build": "pnpm --dir desktop run build:desktop",
    "lint": "pnpm --dir desktop run lint",
    "typecheck": "pnpm --dir desktop run check",
    "test:core": "cargo test -p sarv-quote",
    "desktop:build": "pnpm --dir desktop run build:agent && pnpm --dir desktop exec tauri build",
    "test:desktop": "pnpm --dir desktop test",
    "preview:dev": "pnpm --dir desktop run dev",
    "test:pdf": "cargo test -p sarv-quote --features pdf-export"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1"
  },
  "packageManager": "pnpm@12.5.1"
}
