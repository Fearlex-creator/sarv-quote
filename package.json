{
  "name": "sarv",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm --prefix desktop run tauri -- dev",
    "tauri": "npm --prefix desktop run tauri --",
    "build": "npm --prefix desktop run build:desktop",
    "lint": "npm --prefix desktop run lint",
    "typecheck": "npm --prefix desktop run check",
    "test:core": "cargo test -p sarv-quote",
    "desktop:build": "npm --prefix desktop run tauri -- build",
    "test:desktop": "npm --prefix desktop test",
    "preview:dev": "npm --prefix desktop run dev",
    "test:pdf": "cargo test -p sarv-quote --features pdf-export"
  }
}
