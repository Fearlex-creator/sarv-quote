{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sarv",
  "version": "0.2.0-rc.1",
  "identifier": "ir.sarv.accounting",
  "build": {
    "beforeDevCommand": "pnpm run dev:desktop",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sarv — Accounting",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost https://api.typesafe.ai; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "publisher": "Sarv",
    "copyright": "AGPL-3.0-only",
    "category": "Office",
    "shortDescription": "Shop accounting on this computer",
    "longDescription": "Sarv keeps a shop's books on this computer. It does not file tax returns and it does not replace a signed Windows release.",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}