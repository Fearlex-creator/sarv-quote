{
  "name": "sarv-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "check": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "pnpm run build:qa && playwright test",
    "tauri": "tauri",
    "build:agent": "cargo build --manifest-path ../Cargo.toml --release --no-default-features --bin sarv-agent",
    "build:desktop": "pnpm run build && pnpm run build:agent",
    "dev:desktop": "cargo build --manifest-path ../Cargo.toml --no-default-features --bin sarv-agent && pnpm exec vite --host 0.0.0.0",
    "test:unit": "node --test src/lib/*.test.ts",
    "build:qa": "cargo build --manifest-path ../Cargo.toml -p sarv-quote --example desktop_qa && cargo build --manifest-path ../Cargo.toml -p sarv-quote --no-default-features --bin sarv-agent"
  },
  "dependencies": {
    "@daypicker/persian": "^10.0.2",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-table": "^9.3.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "date-fns-jalali": "4.4.0-0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
